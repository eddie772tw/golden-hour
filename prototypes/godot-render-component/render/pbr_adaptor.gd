extends RefCounted
# Explicit Godot-native PBR adaptor. Real base pixels are unchanged; mixed-axis
# address emulation uses lossless mirrored tiles, not alpha/color rebaking.
var binding
var viewport: Viewport
var textures: Dictionary = {}
var shaders: Dictionary = {}
var emission_scale: float = 1.0
var report: Dictionary = {"mode":"pbr-adaptor-v1","bound":[],"unsupported":[],"warnings":[],"loaded_assets":0,"global_af":8,"source_af_raised":[],"mirrored_tiles":[],"normal_basis":"view-position/normal-map-UV Jacobian cotangent frame; source XY scale; not baked rest tangents","highParity":false}

func prepare(loader, view: Viewport, emission: float) -> void:
	binding = loader
	viewport = view
	emission_scale = emission
	viewport.anisotropic_filtering_level = Viewport.ANISOTROPY_8X
	report.warnings.append("Native AF8 requested for sourceAF4/8; AF4 is intentionally higher quality/cost, AF1 keeps non-anisotropic hint. Driver kernels are not bit-identical.")
	report.warnings.append("POT mirror tiles preserve base bilinear and same-kernel mip/trilinear seams; native anisotropic clamp-edge footprint may differ. No claim of identical GPU sampling.")
	report.warnings.append("Mipmaps regenerated by Godot; sRGB/normal filtering and precision may differ from original WebGL mip generation. Base assets are lossless and hash-verified.")
	report.warnings.append("Godot BRDF/light units, missing procedural shaders/reflection/AO/FX/animation still prevent High parity or performance ranking.")

func _image(id: String) -> Image:
	var item: Dictionary = binding.manifest.textures[id]
	if not str(item.file).begins_with("textures/") or ".." in str(item.file): return null
	var bytes: PackedByteArray = FileAccess.get_file_as_bytes(binding.directory.path_join(str(item.file)))
	if bytes.size()!=int(item.byteLength): return null
	var hash: HashingContext = HashingContext.new()
	hash.start(HashingContext.HASH_SHA256)
	hash.update(bytes)
	if hash.finish().hex_encode()!=str(item.sha256): return null
	var image: Image
	if item.encoding=="rgba8": image=Image.create_from_data(int(item.width),int(item.height),false,Image.FORMAT_RGBA8,bytes)
	elif item.encoding=="png":
		image=Image.new()
		if image.load_png_from_buffer(bytes)!=OK: return null
	else: return null
	if image.get_width()!=int(item.width) or image.get_height()!=int(item.height): return null
	if bool(item.flipY): image.flip_y()
	return image

func _power2(n: int) -> bool:
	return n>0 and (n & (n-1))==0

func _texture(id: String, extend_x: bool, extend_y: bool) -> Texture2D:
	var key: String = id+"/"+str(extend_x)+"/"+str(extend_y)
	if textures.has(key): return textures[key]
	var image: Image = _image(id)
	if image==null: return null
	if extend_x or extend_y:
		if not _power2(image.get_width()) or not _power2(image.get_height()): return null
		var w: int=image.get_width()
		var h: int=image.get_height()
		var extended: Image=Image.create(w*(2 if extend_x else 1),h*(2 if extend_y else 1),false,image.get_format())
		extended.blit_rect(image,Rect2i(0,0,w,h),Vector2i.ZERO)
		if extend_x:
			var flip_x: Image=image.duplicate()
			flip_x.flip_x()
			extended.blit_rect(flip_x,Rect2i(0,0,w,h),Vector2i(w,0))
		if extend_y:
			var flip_y: Image=extended.get_region(Rect2i(0,0,extended.get_width(),h))
			flip_y.flip_y()
			extended.blit_rect(flip_y,Rect2i(0,0,extended.get_width(),h),Vector2i(0,h))
		image=extended
		report.mirrored_tiles.append({"texture":id,"source_size":[w,h],"uploaded_size":[image.get_width(),image.get_height()],"lossless_base_pixels":true,"clamp_anisotropic_edge_kernel_not_bit_identical":true})
	if bool(binding.manifest.textures[id].generateMipmaps): image.generate_mipmaps()
	var texture: ImageTexture=ImageTexture.create_from_image(image)
	textures[key]=texture
	report.loaded_assets+=1
	return texture

func _matrix(m: Array) -> Basis:
	return Basis(Vector3(m[0],m[1],m[2]),Vector3(m[3],m[4],m[5]),Vector3(m[6],m[7],m[8]))

func _reject(id: String, slot: String, reason: String) -> void:
	report.unsupported.append({"material":id,"slot":slot,"reason":reason})

func make_material(id: String) -> ShaderMaterial:
	var source: Dictionary=binding.snapshot.materials[id]
	var maps: Dictionary=binding.manifest.materials[id]
	var modes: PackedStringArray=PackedStringArray(["diffuse_burley","specular_schlick_ggx"])
	if source.type=="MeshBasicMaterial": modes.append("unshaded")
	modes.append("cull_disabled" if int(source.side)==2 else "cull_front" if int(source.side)==1 else "cull_back")
	if not bool(source.depthWrite): modes.append("depth_draw_never")
	if not bool(source.depthTest): modes.append("depth_test_disabled")
	if int(source.blending)==2: modes.append("blend_add")
	elif int(source.blending)==3: modes.append("blend_sub")
	elif int(source.blending)==4: modes.append("blend_mul")
	var code: String="shader_type spatial;\nrender_mode "+",".join(modes)+";\n"
	code+="uniform vec4 source_albedo; uniform vec3 source_emission; uniform float source_roughness; uniform float source_metallic; uniform vec2 source_normal_scale; uniform float source_ao_intensity; uniform float source_alpha_cut;\n"
	var material: ShaderMaterial=ShaderMaterial.new()
	var available: Dictionary={}
	var helpers: String=""
	for slot in ["map","normalMap","roughnessMap","metalnessMap","emissiveMap","alphaMap","aoMap"]:
		if not maps.maps.has(slot): continue
		var item: Dictionary=binding.manifest.textures[maps.maps[slot].texture]
		var reason: String=""
		if item.status!="captured": reason=str(item.get("reason","Not captured"))
		elif bool(item.premultiplyAlpha) or int(item.manualMipmaps)>0: reason="Premultiplied upload/manual source mips not yet mapped"
		elif not str(item.colorSpace) in ["","srgb","srgb-linear"]: reason="Unsupported declared colorSpace"
		elif not int(item.wrapS) in [1000,1001,1002] or not int(item.wrapT) in [1000,1001,1002]: reason="Unknown wrap mode"
		elif int(item.channel)>1: reason="UV channel above retained UV/UV2"
		elif int(item.channel)==1 and not binding._geometry_attribute(id,"uv1"): reason="Missing source UV2"
		elif slot=="normalMap" and int(maps.normalMapType)!=0: reason="Object-space normal map not yet mapped"
		elif float(item.anisotropy)>8.0: reason="Source AF exceeds configured8x; do not lower quality silently"
		var filter_hint: String=""
		if int(item.minFilter)==1003 and int(item.magFilter)==1003: filter_hint="filter_nearest"
		elif int(item.minFilter)==1006 and int(item.magFilter)==1006: filter_hint="filter_linear"
		elif int(item.minFilter)==1008 and int(item.magFilter)==1006 and bool(item.generateMipmaps): filter_hint="filter_linear_mipmap_anisotropic" if float(item.anisotropy)>1.0 else "filter_linear_mipmap"
		if filter_hint.is_empty() and reason.is_empty(): reason="Unvalidated min/mag filter combination"
		if not reason.is_empty():
			_reject(id,slot,reason)
			continue
		var repeating: bool=int(item.wrapS)!=1001 or int(item.wrapT)!=1001
		var extend_x: bool=int(item.wrapS)==1002 or (repeating and int(item.wrapS)==1001)
		var extend_y: bool=int(item.wrapT)==1002 or (repeating and int(item.wrapT)==1001)
		var texture: Texture2D=_texture(item.id,extend_x,extend_y)
		if texture==null:
			_reject(id,slot,"Hash/image/POT tiled texture validation failed")
			continue
		available[slot]={"metadata":item,"texture":texture,"extend_x":extend_x,"extend_y":extend_y}
		var hints: String=("source_color, " if item.colorSpace=="srgb" else "")+filter_hint+", "+("repeat_enable" if repeating else "repeat_disable")
		code+="uniform sampler2D t_"+slot+" : "+hints+"; uniform mat3 m_"+slot+";\n"
		helpers+="vec2 uv_"+slot+"(vec2 base_uv) { return (m_"+slot+" * vec3(base_uv, 1.0)).xy; }\n"
		helpers+="vec4 read_"+slot+"(vec2 base_uv) { vec2 q=uv_"+slot+"(base_uv); vec2 dx=dFdx(q); vec2 dy=dFdy(q);"
		if repeating and int(item.wrapS)==1001: helpers+="q.x=clamp(q.x,0.0,1.0);"
		if repeating and int(item.wrapT)==1001: helpers+="q.y=clamp(q.y,0.0,1.0);"
		if extend_x: helpers+="q.x*=0.5;dx.x*=0.5;dy.x*=0.5;"
		if extend_y: helpers+="q.y*=0.5;dx.y*=0.5;dy.y*=0.5;"
		helpers+="return textureGrad(t_"+slot+",q,dx,dy); }\n"
		if float(item.anisotropy)>1.0 and float(item.anisotropy)<8.0: report.source_af_raised.append({"material":id,"slot":slot,"source":item.anisotropy,"target":8,"cost_quality_change":true})
		report.bound.append({"material":id,"slot":slot,"texture":item.id,"source_af":item.anisotropy,"target_af":8 if float(item.anisotropy)>1.0 else 1,"wrap":[item.wrapS,item.wrapT],"uv":item.matrix})
	code+=helpers
	code+="void fragment() { vec4 base=source_albedo;"
	if int(source.side)==1: code+="NORMAL=-NORMAL;"
	elif int(source.side)==2: code+="if(!FRONT_FACING){NORMAL=-NORMAL;}"
	if bool(source.vertexColors): code+="base*=COLOR;"
	if available.has("map"): code+="base*=read_map("+_uv(available.map.metadata)+");"
	if available.has("alphaMap"): code+="base.a*=read_alphaMap("+_uv(available.alphaMap.metadata)+").g;"
	code+="ALBEDO=base.rgb;ROUGHNESS=source_roughness;METALLIC=source_metallic;EMISSION=source_emission;"
	if available.has("roughnessMap"): code+="ROUGHNESS*=read_roughnessMap("+_uv(available.roughnessMap.metadata)+").g;"
	if available.has("metalnessMap"): code+="METALLIC*=read_metalnessMap("+_uv(available.metalnessMap.metadata)+").b;"
	if available.has("emissiveMap"): code+="EMISSION*=read_emissiveMap("+_uv(available.emissiveMap.metadata)+").rgb;"
	if available.has("aoMap"): code+="AO=clamp(1.0+(read_aoMap("+_uv(available.aoMap.metadata)+").r-1.0)*source_ao_intensity,0.0,1.0);"
	if bool(source.transparent) or float(source.alphaTest)>0.0: code+="ALPHA=base.a;"
	if float(source.alphaTest)>0.0: code+="ALPHA_SCISSOR_THRESHOLD=source_alpha_cut;"
	if available.has("normalMap"):
		# Solve dP/dUV with signed determinant: invariant under framebuffer Y flip.
		# Common scale preserves UV anisotropy; Gram projection follows smooth N.
		code+="vec3 n=normalize(NORMAL);vec2 uvn=uv_normalMap("+_uv(available.normalMap.metadata)+");vec3 px=dFdx(VERTEX);vec3 py=dFdy(VERTEX);vec2 ux=dFdx(uvn);vec2 uy=dFdy(uvn);float det=ux.x*uy.y-ux.y*uy.x;vec3 nm=read_normalMap("+_uv(available.normalMap.metadata)+").rgb*2.0-1.0;nm.xy*=source_normal_scale;if(abs(det)>1e-10){vec3 t=(px*uy.y-py*ux.y)/det;vec3 b=(py*ux.x-px*uy.x)/det;t-=n*dot(n,t);b-=n*dot(n,b);float s=inversesqrt(max(max(dot(t,t),dot(b,b)),1e-10));NORMAL=normalize(t*(nm.x*s)+b*(nm.y*s)+n*nm.z);}"
	code+="}\n"
	if not shaders.has(code):
		var shader: Shader=Shader.new()
		shader.code=code
		shaders[code]=shader
	material.shader=shaders[code]
	material.set_shader_parameter("source_albedo",Vector4(source.color[0],source.color[1],source.color[2],source.opacity))
	material.set_shader_parameter("source_emission",Vector3(source.emissive[0],source.emissive[1],source.emissive[2])*float(source.emissiveIntensity)*emission_scale)
	material.set_shader_parameter("source_roughness",float(source.roughness))
	material.set_shader_parameter("source_metallic",float(source.metalness))
	material.set_shader_parameter("source_normal_scale",Vector2(maps.normalScale[0],maps.normalScale[1]) if maps.normalScale is Array else Vector2.ONE)
	material.set_shader_parameter("source_ao_intensity",float(maps.aoMapIntensity))
	material.set_shader_parameter("source_alpha_cut",float(source.alphaTest))
	for slot in available:
		material.set_shader_parameter("t_"+slot,available[slot].texture)
		material.set_shader_parameter("m_"+slot,_matrix(available[slot].metadata.matrix))
	return material

func _uv(item: Dictionary) -> String:
	return "UV2" if int(item.channel)==1 else "UV"
